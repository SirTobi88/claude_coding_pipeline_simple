{
  "mode": "local",
  "default_branch": "main",
  "test_command": "./run_tests.sh",
  "ci": true,
  "runner": "auto",
  "auto_runner": { "1": "codex", "2": "codex", "3": "codex", "4": "claude", "5": "claude" },
  "max_tasks_per_plan": 6,
  "tiers": {
    "1": { "claude": { "model": "haiku",  "effort": "high" },    "codex": { "family": "luna",  "effort": "high" },    "local": null },
    "2": { "claude": { "model": "sonnet", "effort": "medium" }, "codex": { "family": "sol",   "effort": "medium" }, "local": null },
    "3": { "claude": { "model": "sonnet", "effort": "high" },   "codex": { "family": "sol",   "effort": "medium" }, "local": null },
    "4": { "claude": { "model": "opus",   "effort": "medium" },   "codex": { "family": "sol",   "effort": "high" },   "local": null },
    "5": { "claude": { "model": "opus",   "effort": "max" },    "codex": { "family": "astra", "effort": "medium" },   "local": null }
  },
  "reviewer": {
    "runner": "codex",
    "default": { "claude": { "model": "opus",  "effort": "medium" }, "codex": { "family": "astra", "effort": "medium" } },
    "4":       { "claude": { "model": "opus",  "effort": "high" },   "codex": { "family": "astra", "effort": "medium" } },
    "5":       { "claude": { "model": "opus",  "effort": "xhigh" }, "codex": { "family": "astra", "effort": "high" } }
  }
}
